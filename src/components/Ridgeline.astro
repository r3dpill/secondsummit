---
/**
 * The signature ridgeline: two named summits — Coast to Coast ticked green,
 * Snowdonia Way magenta — with the ridge fading to a dotted "— we'll see".
 * Carried over from the approved prototype.
 */
---

<div class="ridge-wrap">
  <svg
    class="ridge-svg"
    viewBox="0 0 680 150"
    role="img"
    aria-label="A ridgeline: Coast to Coast walked, Snowdonia Way next, the ridge continuing unnamed beyond"
  >
    <!-- contour ghost lines -->
    <path
      d="M0 120 Q 90 112 170 116 T 340 110 T 510 104 T 680 96"
      fill="none"
      stroke="var(--ridge-ghost)"
      stroke-width="1"></path>
    <path
      d="M0 132 Q 90 126 170 129 T 340 124 T 510 119 T 680 112"
      fill="none"
      stroke="var(--ridge-ghost)"
      stroke-width="1"></path>
    <!-- ridgeline: two summits named, the rest fades into weather -->
    <path
      d="M0 138 L90 92 L150 116 L250 66 L320 98"
      fill="none"
      stroke="var(--ridge-line)"
      stroke-width="2.5"
      stroke-linejoin="round"></path>
    <path
      d="M320 98 L400 62 L460 84 L540 48 L600 70 L680 36"
      fill="none"
      stroke="var(--ridge-line)"
      stroke-width="2"
      stroke-linejoin="round"
      stroke-dasharray="1 7"
      stroke-linecap="round"
      opacity=".55"></path>
    <!-- C2C summit: walked -->
    <circle cx="90" cy="92" r="5.5" fill="var(--live)"></circle>
    <!-- Snowdonia: next, magenta -->
    <circle cx="250" cy="66" r="5.5" fill="var(--landranger)"></circle>
  </svg>
  <div class="ridge-labels">
    <b>COAST TO COAST ✓</b>
    <b class="next">SNOWDONIA WAY · OCT</b>
    <span class="later">— we'll see</span>
  </div>
</div>
