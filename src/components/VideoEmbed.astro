---
/**
 * YouTube embed as a click-to-load facade: we ship a poster image and a button,
 * and only pull in the YouTube player once someone actually presses play.
 * A live iframe per video costs ~1MB of third-party JS and would sink the
 * mobile Lighthouse score the brief asks for.
 *
 * With `id` unset the card renders as a labelled placeholder, so pages can be
 * built and approved before the films exist.
 */
interface Props {
  id?: string | null;
  kicker?: string;
  title: string;
  /** Full-width card (home / archive hero) rather than a strip item. */
  wide?: boolean;
}

const { id = null, kicker, title, wide = false } = Astro.props;
---

{
  id ? (
    <figure class="embed" data-yt={id}>
      <button class="yt-play" type="button" aria-label={`Play: ${title}`}>
        <img
          src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
          alt=""
          loading="lazy"
          decoding="async"
          width="480"
          height="360"
        />
        <span class="yt-btn" aria-hidden="true" />
      </button>
    </figure>
  ) : (
    <div class:list={['vlog', wide && 'wide']}>
      <div class="thumb">▸ film to follow</div>
      <div class="meta">
        {kicker && <div class="d">{kicker}</div>}
        <div class="t">{title}</div>
      </div>
    </div>
  )
}

<style>
  .yt-play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--slate);
    cursor: pointer;
    display: block;
  }

  .yt-play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .yt-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 62px;
    height: 44px;
    border-radius: 10px;
    background: var(--landranger);
    display: block;
  }

  .yt-btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-40%, -50%);
    border-left: 16px solid var(--paper);
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
  }

  .yt-play:hover .yt-btn,
  .yt-play:focus-visible .yt-btn {
    background: var(--ink);
  }
</style>

<script>
  // Swap the facade for the real player on first press. Idempotent and safe to
  // run once per page regardless of how many embeds are present.
  document.querySelectorAll<HTMLElement>('.embed[data-yt]').forEach((figure) => {
    const button = figure.querySelector<HTMLButtonElement>('.yt-play');
    const id = figure.dataset.yt;
    if (!button || !id) return;

    button.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = 'YouTube video player';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        button.replaceWith(iframe);
      },
      { once: true },
    );
  });
</script>
