---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Full-bleed banner photograph.
 *
 * A banner is a different shape on a laptop (letterbox) and on a phone
 * (nearly square, or taller). Rather than shipping two crops of everything,
 * one wide master is cropped by CSS: the aspect ratio changes at the
 * breakpoint and `focal` decides which part of the frame survives the crop.
 * On a landscape shot the subject is rarely dead centre, so that control is
 * the difference between a good banner and a beheaded one.
 *
 * Where a single master genuinely cannot work — a tall subject that needs a
 * different composition on a phone — pass `portraitImage` and that file is
 * used below the breakpoint instead. True art direction, only where it earns
 * the second file.
 */
interface Props {
  image: ImageMetadata;
  alt: string;
  /** Optional second master used on narrow screens. */
  portraitImage?: ImageMetadata | null;
  /**
   * CSS object-position for the crop, e.g. 'center 35%' to favour the top.
   * Defaults to centre.
   */
  focal?: string;
  /** Shown under the image. */
  caption?: string;
  /**
   * The first banner on a page should load eagerly — it is usually the
   * largest contentful paint. Everything below the fold should not.
   */
  priority?: boolean;
}

const {
  image,
  alt,
  portraitImage = null,
  focal = 'center center',
  caption,
  priority = false,
} = Astro.props;
---

<figure class="banner" style={`--focal:${focal}`}>
  <div class="frame">
    {
      portraitImage && (
        <Image
          class="portrait"
          src={portraitImage}
          alt={alt}
          widths={[420, 640, 900]}
          sizes="100vw"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
        />
      )
    }
    <Image
      class:list={['wide', portraitImage && 'has-portrait']}
      src={image}
      alt={portraitImage ? '' : alt}
      widths={[640, 960, 1400, 1920]}
      sizes="100vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .banner {
    margin: 0;
  }

  /* Breaks the reading column: a banner boxed into 680px is not a banner. */
  .frame {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    max-width: 100vw;
    overflow: hidden;
    background: var(--chart-bg);

    /* Phone: close to square, so the photograph has some height to it. */
    aspect-ratio: 4 / 3;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focal);
    display: block;
  }

  /* One master by default; a portrait file takes over below the breakpoint. */
  .frame :global(.portrait) {
    display: block;
  }

  .frame :global(.wide.has-portrait) {
    display: none;
  }

  figcaption {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 8px 20px 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  @media (min-width: 560px) {
    .frame {
      aspect-ratio: 16 / 9;
    }

    .frame :global(.portrait) {
      display: none;
    }

    .frame :global(.wide.has-portrait) {
      display: block;
    }
  }

  /* Laptop: proper letterbox, but capped so it never eats the whole screen. */
  @media (min-width: 900px) {
    .frame {
      aspect-ratio: 21 / 9;
      max-height: 60vh;
    }

  }
</style>
