---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Photo band for the teaser. Slots without an image render as styled empty
 * frames carrying their caption, so the layout is finished and reviewable
 * before the photographs exist. No stock imagery — an empty slot is honest,
 * a borrowed picture is not.
 */
interface Slot {
  caption: string;
  alt: string;
  image?: ImageMetadata | null;
}

interface Props {
  slots: readonly Slot[];
}

const { slots } = Astro.props;
---

<ul class="band">
  {
    slots.map((slot) => (
      <li class="slot">
        <figure>
          {slot.image ? (
            <Image
              src={slot.image}
              alt={slot.alt}
              widths={[320, 640, 960]}
              sizes="(min-width: 720px) 340px, 80vw"
              loading="lazy"
            />
          ) : (
            <div class="empty" role="img" aria-label={`Photograph to come: ${slot.alt}`}>
              <span class="mark" aria-hidden="true">
                ▲
              </span>
              <span class="waiting">Photograph to come</span>
            </div>
          )}
          <figcaption>{slot.caption}</figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  /* Scrolls sideways on a phone, grid on anything wider — the band is meant
     to be swiped through, not stacked into a long column. */
  .band {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: 12px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    padding-bottom: 8px;
    margin: 0 -20px;
    padding-inline: 20px;
  }

  .slot {
    scroll-snap-align: start;
  }

  figure {
    margin: 0;
  }

  .slot :global(img),
  .empty {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--line);
    display: block;
  }

  .empty {
    background: var(--chart-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-style: dashed;
  }

  .mark {
    color: var(--landranger);
    font-size: 1.1rem;
    line-height: 1;
  }

  .waiting {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  figcaption {
    font-size: 0.8rem;
    color: var(--muted);
    padding-top: 8px;
    line-height: 1.45;
  }

  @media (min-width: 720px) {
    .band {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, 1fr);
      grid-auto-columns: auto;
      overflow: visible;
      margin: 0;
      padding-inline: 0;
    }
  }
</style>
