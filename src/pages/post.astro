---
import Base from '../layouts/Base.astro';

/**
 * Private field-posting form. Static HTML; the real gate is server-side in
 * functions/api/publish.ts — this page just collects the post and talks to it.
 *
 * Design constraints from the brief: one-handed on a phone, on mobile data,
 * evening, low battery, patchy signal. So: no framework, no client routing,
 * drafts survive in localStorage, photos are resized before they ever hit the
 * network, and a failed publish keeps everything and offers a retry.
 */
---

<Base title="Post" description="Private posting form." noindex gridref="FIELD POST">
  <noscript>
    <section>
      <div class="eyebrow">Field post</div>
      <h1 class="sub">JavaScript needed</h1>
      <p class="lede">
        This form resizes photos on the phone before uploading, so it needs JavaScript switched on.
        If that isn't possible, use the backup route:
        <a href="https://app.pagescms.org">Pages CMS</a>.
      </p>
    </section>
  </noscript>

  <section id="gate" hidden>
    <div class="eyebrow">Sign in</div>
    <h1 class="sub">Field post</h1>
    <form id="login-form" novalidate>
      <label for="passphrase">Passphrase</label>
      <input
        id="passphrase"
        name="passphrase"
        type="password"
        autocomplete="current-password"
        enterkeyhint="go"
        required
      />
      <p class="err" id="login-error" role="alert" hidden></p>
      <button type="submit" class="primary">Sign in</button>
      <p class="small">Stays signed in for 90 days on this phone.</p>
    </form>
  </section>

  <section id="composer" hidden>
    <div class="eyebrow">Field post</div>
    <h1 class="sub">New entry</h1>

    <form id="post-form" novalidate>
      <label for="title">Title</label>
      <input id="title" name="title" type="text" enterkeyhint="next" autocapitalize="sentences" required />

      <label for="body">Words</label>
      <textarea id="body" name="body" rows="10" autocapitalize="sentences"></textarea>

      <label for="photos" class="filelabel">
        <span>Add photos</span>
        <input id="photos" name="photos" type="file" accept="image/*" multiple />
      </label>
      <p class="small" id="photo-status">Resized on the phone before upload.</p>
      <ul class="thumbs" id="thumbs"></ul>

      <div class="row2">
        <div>
          <label for="category">Walk</label>
          <select id="category" name="category">
            <option value="snowdonia-way" selected>Snowdonia Way</option>
            <option value="coast-to-coast">Coast to Coast</option>
            <option value="training">Training</option>
          </select>
        </div>
        <div>
          <label for="day">Day</label>
          <input id="day" name="day" type="number" inputmode="numeric" min="0" max="99" />
        </div>
      </div>

      <details id="more">
        <summary>Conditions &amp; extras</summary>
        <label for="stage">Stage</label>
        <input id="stage" name="stage" type="text" autocapitalize="sentences" />

        <label for="summits">Summits</label>
        <input id="summits" name="summits" type="text" autocapitalize="sentences" />

        <label for="wind">Wind on ridges</label>
        <input id="wind" name="wind" type="text" autocapitalize="sentences" />

        <label for="cloudBase">Cloud base</label>
        <input id="cloudBase" name="cloudBase" type="text" autocapitalize="sentences" />

        <label for="rain">Rain</label>
        <input id="rain" name="rain" type="text" autocapitalize="sentences" />

        <label for="call">The call</label>
        <input id="call" name="call" type="text" autocapitalize="sentences" />

        <label for="distance">Distance</label>
        <input id="distance" name="distance" type="text" placeholder="9.9 mi" />

        <label for="video">YouTube video ID</label>
        <input id="video" name="video" type="text" autocapitalize="off" autocorrect="off" />
      </details>

      <p class="err" id="post-error" role="alert" hidden></p>
      <p class="ok" id="post-ok" role="status" hidden></p>

      <button type="submit" class="primary" id="publish">Post</button>
      <div class="actions">
        <button type="button" id="clear">Discard draft</button>
        <button type="button" id="signout">Sign out</button>
      </div>
      <p class="small" id="draft-status"></p>
    </form>
  </section>
</Base>

<style>
  label,
  .filelabel > span {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 16px 0 5px;
  }

  input[type='text'],
  input[type='password'],
  input[type='number'],
  select,
  textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--input-bg);
    color: var(--ink);
  }

  textarea {
    line-height: 1.5;
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--landranger);
    outline-offset: 1px;
  }

  .filelabel input[type='file'] {
    width: 100%;
    font-size: 0.9rem;
  }

  .row2 {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 12px;
  }

  details {
    margin-top: 20px;
    border-top: 1px solid var(--line);
    padding-top: 8px;
  }

  summary {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--landranger);
    cursor: pointer;
    padding: 8px 0;
  }

  button.primary {
    width: 100%;
    margin-top: 20px;
    padding: 16px;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--landranger);
    color: #fff;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
  }

  button.primary[disabled] {
    background: var(--muted);
    cursor: progress;
  }

  .actions {
    display: flex;
    gap: 12px;
    margin-top: 12px;
  }

  .actions button {
    flex: 1;
    padding: 10px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: none;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--muted);
    cursor: pointer;
  }

  .thumbs {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
    gap: 8px;
    margin-top: 10px;
  }

  .thumbs li {
    position: relative;
  }

  .thumbs img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--line);
    display: block;
  }

  .thumbs button {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 0;
    background: rgba(23, 31, 36, 0.82);
    color: #fff;
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
  }

  .err,
  .ok {
    margin-top: 14px;
    padding: 11px 13px;
    border-radius: 6px;
    font-size: 0.88rem;
  }

  .err {
    background: #fdeaf2;
    border-left: 3px solid var(--landranger);
    color: #7a0e43;
  }

  .ok {
    background: #e7f5ed;
    border-left: 3px solid var(--live);
    color: #10502f;
  }

  .small {
    margin-top: 8px;
  }
</style>

<script>
  const DRAFT_KEY = 'ss.field-post.draft';
  /** Long edge in pixels after resize — plenty for the site, small on 3G. */
  const MAX_EDGE = 1600;
  const JPEG_QUALITY = 0.72;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const gate = $<HTMLElement>('gate');
  const composer = $<HTMLElement>('composer');
  const postForm = $<HTMLFormElement>('post-form');
  const loginForm = $<HTMLFormElement>('login-form');
  const thumbs = $<HTMLUListElement>('thumbs');
  const publishButton = $<HTMLButtonElement>('publish');
  const postError = $<HTMLElement>('post-error');
  const postOk = $<HTMLElement>('post-ok');
  const loginError = $<HTMLElement>('login-error');
  const photoStatus = $<HTMLElement>('photo-status');
  const draftStatus = $<HTMLElement>('draft-status');

  const TEXT_FIELDS = [
    'title',
    'body',
    'category',
    'day',
    'stage',
    'summits',
    'wind',
    'cloudBase',
    'rain',
    'call',
    'distance',
    'video',
  ] as const;

  /** Resized photos, held as base64 so a draft survives a reload. */
  let photos: { data: string; ext: string; alt: string }[] = [];

  const show = (el: HTMLElement, message?: string) => {
    if (message !== undefined) el.textContent = message;
    el.hidden = false;
  };
  const hide = (el: HTMLElement) => {
    el.hidden = true;
  };

  // ---------------------------------------------------------------- draft

  function saveDraft() {
    const values: Record<string, string> = {};
    for (const name of TEXT_FIELDS) {
      values[name] = ($(name) as HTMLInputElement).value;
    }
    try {
      localStorage.setItem(DRAFT_KEY, JSON.stringify({ values, photos, saved: Date.now() }));
      draftStatus.textContent = `Draft saved ${new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}.`;
    } catch {
      // Out of quota — usually too many photos. The post still works; only the
      // crash-recovery copy is lost, and saying so beats failing silently.
      draftStatus.textContent = 'Draft too large to auto-save — post before closing the page.';
    }
  }

  function loadDraft() {
    const raw = localStorage.getItem(DRAFT_KEY);
    if (!raw) return;
    try {
      const draft = JSON.parse(raw);
      for (const [name, value] of Object.entries(draft.values ?? {})) {
        const field = document.getElementById(name) as HTMLInputElement | null;
        if (field && typeof value === 'string') field.value = value;
      }
      photos = Array.isArray(draft.photos) ? draft.photos : [];
      renderThumbs();
      if (draft.saved) {
        draftStatus.textContent = `Draft restored from ${new Date(draft.saved).toLocaleString('en-GB')}.`;
      }
      if (photos.length) {
        (document.getElementById('more') as HTMLDetailsElement).open = Boolean(draft.values?.stage);
      }
    } catch {
      localStorage.removeItem(DRAFT_KEY);
    }
  }

  function clearDraft() {
    localStorage.removeItem(DRAFT_KEY);
    postForm.reset();
    photos = [];
    renderThumbs();
    draftStatus.textContent = '';
  }

  let saveTimer: number | undefined;
  postForm.addEventListener('input', () => {
    hide(postError);
    window.clearTimeout(saveTimer);
    saveTimer = window.setTimeout(saveDraft, 400);
  });

  // ---------------------------------------------------------------- photos

  function renderThumbs() {
    thumbs.replaceChildren();
    photos.forEach((photo, index) => {
      const li = document.createElement('li');
      const img = document.createElement('img');
      img.src = `data:image/${photo.ext === 'png' ? 'png' : 'jpeg'};base64,${photo.data}`;
      img.alt = photo.alt || `Photo ${index + 1}`;
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = '×';
      remove.setAttribute('aria-label', `Remove photo ${index + 1}`);
      remove.addEventListener('click', () => {
        photos.splice(index, 1);
        renderThumbs();
        saveDraft();
      });
      li.append(img, remove);
      thumbs.append(li);
    });
    photoStatus.textContent = photos.length
      ? `${photos.length} photo${photos.length === 1 ? '' : 's'} ready. First one becomes the cover.`
      : 'Resized on the phone before upload.';
  }

  /** Downscale in the browser: mountain bandwidth is the binding constraint. */
  async function resize(file: File): Promise<string> {
    const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
    const scale = Math.min(1, MAX_EDGE / Math.max(bitmap.width, bitmap.height));
    const width = Math.round(bitmap.width * scale);
    const height = Math.round(bitmap.height * scale);

    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const context = canvas.getContext('2d');
    if (!context) throw new Error('Canvas unavailable');
    context.drawImage(bitmap, 0, 0, width, height);
    bitmap.close();

    const blob: Blob = await new Promise((resolve, reject) =>
      canvas.toBlob(
        (b) => (b ? resolve(b) : reject(new Error('Could not encode photo'))),
        'image/jpeg',
        JPEG_QUALITY,
      ),
    );

    const buffer = new Uint8Array(await blob.arrayBuffer());
    let binary = '';
    for (let i = 0; i < buffer.length; i += 0x8000) {
      binary += String.fromCharCode(...buffer.subarray(i, i + 0x8000));
    }
    return btoa(binary);
  }

  $<HTMLInputElement>('photos').addEventListener('change', async (event) => {
    const input = event.target as HTMLInputElement;
    const files = [...(input.files ?? [])];
    input.value = '';
    if (!files.length) return;

    for (const [i, file] of files.entries()) {
      photoStatus.textContent = `Resizing photo ${i + 1} of ${files.length}…`;
      try {
        photos.push({ data: await resize(file), ext: 'jpg', alt: '' });
      } catch (err) {
        show(postError, `Could not read ${file.name}. Try a different photo.`);
      }
    }
    renderThumbs();
    saveDraft();
  });

  // ---------------------------------------------------------------- auth

  async function checkSession(): Promise<boolean> {
    try {
      const res = await fetch('/api/session', { credentials: 'same-origin' });
      const data = await res.json();
      return Boolean(data.authenticated);
    } catch {
      return false;
    }
  }

  function showComposer() {
    hide(gate);
    show(composer);
  }

  function showGate() {
    hide(composer);
    show(gate);
  }

  loginForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    hide(loginError);
    const passphrase = $<HTMLInputElement>('passphrase').value;
    try {
      const res = await fetch('/api/session', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ passphrase }),
      });
      const data = await res.json();
      if (!res.ok) {
        show(loginError, data.error ?? 'Could not sign in.');
        return;
      }
      $<HTMLInputElement>('passphrase').value = '';
      showComposer();
    } catch {
      show(loginError, 'No connection. Try again when you have signal.');
    }
  });

  $<HTMLButtonElement>('signout').addEventListener('click', async () => {
    await fetch('/api/session', { method: 'DELETE', credentials: 'same-origin' }).catch(() => {});
    showGate();
  });

  $<HTMLButtonElement>('clear').addEventListener('click', () => {
    if (confirm('Discard this draft?')) clearDraft();
  });

  // ---------------------------------------------------------------- publish

  postForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    hide(postError);
    hide(postOk);

    const title = $<HTMLInputElement>('title').value.trim();
    const body = $<HTMLTextAreaElement>('body').value.trim();
    if (!title) {
      show(postError, 'A title is needed.');
      return;
    }
    if (!body && photos.length === 0) {
      show(postError, 'Add some words or a photo.');
      return;
    }

    saveDraft();
    publishButton.disabled = true;
    publishButton.textContent = 'Posting…';

    const payload = {
      title,
      body,
      category: $<HTMLSelectElement>('category').value,
      day: $<HTMLInputElement>('day').value,
      distance: $<HTMLInputElement>('distance').value,
      video: $<HTMLInputElement>('video').value,
      pubDate: new Date().toISOString(),
      conditions: {
        stage: $<HTMLInputElement>('stage').value,
        summits: $<HTMLInputElement>('summits').value,
        wind: $<HTMLInputElement>('wind').value,
        cloudBase: $<HTMLInputElement>('cloudBase').value,
        rain: $<HTMLInputElement>('rain').value,
        call: $<HTMLInputElement>('call').value,
      },
      photos,
    };

    try {
      const res = await fetch('/api/publish', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok) {
        clearDraft();
        show(
          postOk,
          `Posted. It goes live in a minute or two at ${data.url} — the site rebuilds itself.`,
        );
        return;
      }

      if (data.reauth) {
        show(postError, 'Signed out. Sign in again — your draft is safe.');
        showGate();
        return;
      }

      show(
        postError,
        `${data.error ?? 'Could not publish.'} ${data.retryable === false ? '' : 'Press Post again to retry — nothing was lost.'}`.trim(),
      );
    } catch {
      // Almost always lost signal mid-request. The draft is already saved.
      show(postError, 'No connection. Your draft is saved — press Post again when signal returns.');
    } finally {
      publishButton.disabled = false;
      publishButton.textContent = 'Post';
    }
  });

  // ---------------------------------------------------------------- boot

  loadDraft();
  if (await checkSession()) showComposer();
  else showGate();
</script>
