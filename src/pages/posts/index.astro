---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
import { CATEGORIES } from '../../site';

const posts = await getPosts();
const counts = new Map<string, number>();
for (const post of posts) {
  counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1);
}
---

<Base
  title="All posts"
  description="Everything filed from the walks — Coast to Coast, Snowdonia Way and training."
>
  <section style="padding-bottom:16px">
    <div class="eyebrow">Everything filed</div>
    <h1 class="sub">Posts</h1>
    <p class="small" style="margin-top:8px">
      {posts.length} post{posts.length === 1 ? '' : 's'} · <a href="/rss.xml">RSS</a>
    </p>
  </section>

  <section>
    <div class="eyebrow">By walk</div>
    <ul class="daylist">
      {
        Object.entries(CATEGORIES).map(([key, meta]) => (
          <li>
            <span class="stage">
              <a href={meta.href}>{meta.label}</a>
            </span>
            <span class="mi">{counts.get(key) ?? 0}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <ul class="postlist">
      {posts.map((post) => <PostCard post={post} />)}
    </ul>
  </section>
</Base>
