---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ConditionsCard from '../../components/ConditionsCard.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { getPosts, postUrl, formatDate, type Post } from '../../lib/posts';
import { CATEGORIES } from '../../site';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  // Posts are newest-first; walking order is the reverse for prev/next.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
};

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, category, day, distance, cover, coverAlt, video, conditions } =
  post.data;
const { Content } = await render(post);
const section = CATEGORIES[category];
---

<Base title={title} description={description}>
  <section style="padding-bottom:16px">
    <div class="eyebrow">
      <a href={section.href}>{section.label}</a>
      {day != null && ` · Day ${day}`}
      {distance && ` · ${distance}`}
    </div>
    <h1 class="sub">{title}</h1>
    <div class="postmeta">{formatDate(pubDate)}</div>
  </section>

  {
    cover && (
      <section>
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[400, 800, 1200]}
          sizes="(min-width: 720px) 680px, 100vw"
          loading="eager"
          style="width:100%;height:auto;border-radius:6px;border:1px solid var(--line)"
        />
      </section>
    )
  }

  {
    conditions && (
      <section>
        <h2>Conditions</h2>
        <ConditionsCard conditions={conditions} />
      </section>
    )
  }

  {
    video && (
      <section>
        <VideoEmbed id={video} title={title} wide />
      </section>
    )
  }

  <section class="prose">
    <Content />
  </section>

  <section class="pager">
    {older ? <a href={postUrl(older)}>← {older.data.title}</a> : <span />}
    {newer ? <a href={postUrl(newer)}>{newer.data.title} →</a> : <span />}
  </section>
</Base>
